# Frontend environment (copy to `.env` as needed)

# Public URL for Open Graph / sitemap absolute links
VITE_SITE_URL=https://sentinel.app

# Dev proxy target for /api and /ws (vite.config.ts)
VITE_API_PROXY=http://localhost:8080

# Optional absolute API/WS overrides (desk uses same-origin proxy by default)
# VITE_API_BASE_URL=http://localhost:8080
# VITE_WS_URL=ws://localhost:8080/ws

# Uncomment when ready:
# VITE_GA_MEASUREMENT_ID=G-XXXXXXXXXX
# VITE_GTM_ID=GTM-XXXXXXX
# VITE_GOOGLE_SITE_VERIFICATION=
