# --- Shared ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=sentinel
POSTGRES_USER=sentinel
POSTGRES_PASSWORD=sentinel_change_me

# --- Spring Boot (backend) ---
SERVER_PORT=8080
JWT_SECRET=change_me_to_a_long_random_string
JWT_ACCESS_TOKEN_EXPIRY_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRY_DAYS=7
CV_ML_BASE_URL=http://localhost:8001
TRANSACTION_ML_BASE_URL=http://localhost:8002
UPLOAD_MAX_SIZE_MB=10
RABBITMQ_ENABLED=false
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672

# --- Python CV/ML ---
CV_ML_PORT=8001
MODEL_DIR=/app/models

# --- Python Transaction ML ---
TX_ML_PORT=8002

# --- Frontend ---
VITE_API_BASE_URL=http://localhost:8080
VITE_WS_URL=ws://localhost:8080/ws

# Public site URL (used for Open Graph / WhatsApp / SEO absolute links)
VITE_SITE_URL=https://sentinel.app

# Google Analytics 4 measurement ID (optional)
# VITE_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Google Tag Manager container ID (optional)
# VITE_GTM_ID=GTM-XXXXXXX

# Google Search Console verification token (optional)
# VITE_GOOGLE_SITE_VERIFICATION=
